<UserControl x:Class="PomodoroFocus.App.Views.FocusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PomodoroFocus.App.Controls"
             xmlns:themes="clr-namespace:PomodoroFocus.App.Themes"
             xmlns:views="clr-namespace:PomodoroFocus.App.Views"
             xmlns:vm="clr-namespace:PomodoroFocus.App.ViewModels">
    <UserControl.Resources>
        <vm:BoolToVisConverter x:Key="BoolToVis" />
        <vm:BoolToVisConverter x:Key="InvBoolToVis" Invert="True" />
        <views:GeoKeyConverter x:Key="GeoConverter" />
    </UserControl.Resources>

    <Grid Margin="{Binding Main.PageHorizontalPadding}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="440" />
            <ColumnDefinition x:Name="RightRailCol" Width="300" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Center Focus Stage -->
        <Grid x:Name="CenterStageGrid" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 1. Top Phase SegmentedControl -->
            <controls:SegmentedControl x:Name="ModeSegmentControl"
                                       Grid.Row="0"
                                       Width="352"
                                       SegmentHeight="32"
                                       UsePhaseAccent="True"
                                       Items="{Binding ModeOptions}"
                                       SelectedKey="{Binding SelectedModeKey, Mode=OneWay}"
                                       SelectionClicked="OnModeSegmentClicked"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,18" />

            <!-- 2. Central Circular Timer Ring + 4-row inner content -->
            <Grid x:Name="RingStageGrid" Grid.Row="1" Width="308" Height="308" HorizontalAlignment="Center">
                <controls:CircularTimerRing x:Name="TimerRing"
                                            Progress="{Binding Progress}"
                                            IsRunning="{Binding IsRunning}"
                                            TrackBrush="{DynamicResource Ring.Track}"
                                            TickBrush="{DynamicResource Ring.Tick}"
                                            PhaseStartBrush="{DynamicResource Phase.StartBrush}"
                                            PhaseEndBrush="{DynamicResource Phase.EndBrush}"
                                            PhaseGradient="{DynamicResource Phase.Gradient}" />

                <!-- Inner 4 rows vertically balanced -->
                <StackPanel x:Name="RingInnerStack" VerticalAlignment="Center" HorizontalAlignment="Center" Width="256">
                    <!-- Row 1: Phase Pill Badge -->
                    <Border Height="26"
                            CornerRadius="13"
                            Padding="12,0"
                            Background="{DynamicResource Phase.SoftBrush}"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource Phase.StartBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource Warning}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding PhaseBadgeText}"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Phase.StartBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Row 2: Big Tabular Timer Digits (clickable in Idle Focus for custom duration) -->
                    <Button x:Name="TimerDigitsButton"
                            Command="{Binding OpenCustomDurationCommand}"
                            HorizontalAlignment="Center"
                            MinWidth="240"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="4,0"
                            RenderTransformOrigin="0.5,0.5">
                        <Button.RenderTransform>
                            <ScaleTransform x:Name="TimerDigitsScale" ScaleX="1" ScaleY="1" />
                        </Button.RenderTransform>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Cursor" Value="Arrow" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="Transparent">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanAdjustCustomDuration}" Value="True">
                                        <Setter Property="Cursor" Value="Hand" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock x:Name="TimerDisplayText"
                                   AutomationProperties.AutomationId="TimerDisplayText"
                                   Text="{Binding TimerText}"
                                   FontFamily="{StaticResource Font.Display}"
                                   FontSize="{Binding TimerFontSize}"
                                   FontWeight="Light"
                                   Foreground="{DynamicResource Text.Primary}"
                                   Typography.NumeralAlignment="Tabular"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center" />
                    </Button>

                    <!-- Custom Duration Popup -->
                    <Popup IsOpen="{Binding IsCustomDurationPopupOpen, Mode=TwoWay}"
                           PlacementTarget="{Binding ElementName=TimerDigitsButton}"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           PopupAnimation="Fade">
                        <Border Width="276"
                                Background="{DynamicResource Surface.Solid}"
                                BorderBrush="{DynamicResource Stroke.Strong}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="16"
                                Margin="8">
                            <Border.Effect>
                                <DropShadowEffect Color="{DynamicResource Shadow.Color}" BlurRadius="24" ShadowDepth="6" Opacity="{DynamicResource Shadow.Opacity}" />
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="调整本次专注时长（分钟）" Style="{StaticResource Text.BodyStrong}" Margin="0,0,0,12" />
                                <UniformGrid Columns="5" Margin="0,0,0,12">
                                    <Button Content="15" Command="{Binding SetPresetDurationCommand}" CommandParameter="15" Style="{StaticResource Button.Secondary}" Height="30" MinWidth="42" Padding="0" Margin="0,0,4,0" themes:ControlProps.CornerRadius="8" />
                                    <Button Content="25" Command="{Binding SetPresetDurationCommand}" CommandParameter="25" Style="{StaticResource Button.Secondary}" Height="30" MinWidth="42" Padding="0" Margin="2,0" themes:ControlProps.CornerRadius="8" />
                                    <Button Content="45" Command="{Binding SetPresetDurationCommand}" CommandParameter="45" Style="{StaticResource Button.Secondary}" Height="30" MinWidth="42" Padding="0" Margin="2,0" themes:ControlProps.CornerRadius="8" />
                                    <Button Content="60" Command="{Binding SetPresetDurationCommand}" CommandParameter="60" Style="{StaticResource Button.Secondary}" Height="30" MinWidth="42" Padding="0" Margin="2,0" themes:ControlProps.CornerRadius="8" />
                                    <Button Content="90" Command="{Binding SetPresetDurationCommand}" CommandParameter="90" Style="{StaticResource Button.Secondary}" Height="30" MinWidth="42" Padding="0" Margin="4,0,0,0" themes:ControlProps.CornerRadius="8" />
                                </UniformGrid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <controls:NumberStepper Grid.Column="0" Value="{Binding CustomMinutesDraft, Mode=TwoWay}" Minimum="1" Maximum="180" />
                                    <Button Grid.Column="1" Content="确定" Command="{Binding ApplyCustomDurationCommand}" Style="{StaticResource Button.Primary}" HorizontalAlignment="Right" MinWidth="76" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <!-- Row 3: Subtitle -->
                    <TextBlock Text="{Binding SubtitleText}"
                               FontSize="12"
                               Foreground="{DynamicResource Text.Secondary}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Margin="0,2,0,12" />

                    <!-- Row 4: Cycle Tomato Dots -->
                    <ItemsControl ItemsSource="{Binding CycleDots}"
                                  HorizontalAlignment="Center"
                                  Visibility="{Binding IsStopwatch, Converter={StaticResource InvBoolToVis}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Height="8" CornerRadius="4" Margin="4,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Width" Value="8" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource Ring.Tick}" />
                                            <Setter Property="BorderThickness" Value="1.5" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource Phase.StartBrush}" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                    <Setter Property="Width" Value="20" />
                                                    <Setter Property="Background" Value="{DynamicResource Phase.Gradient}" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>

            <!-- 3. Control Buttons Bar -->
            <StackPanel x:Name="ControlBarPanel" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                <Button AutomationProperties.AutomationId="TimerResetButton"
                        Command="{Binding ResetCommand}"
                        Style="{StaticResource Button.CircleIcon}"
                        ToolTip="重置 (R)"
                        Margin="0,0,18,0">
                    <TextBlock Text="{StaticResource Icon.Reset}" Style="{StaticResource IconGlyph}" FontSize="16" />
                </Button>

                <Button x:Name="PrimaryTimerButton"
                        AutomationProperties.AutomationId="TimerToggleButton"
                        Command="{Binding ToggleCommand}"
                        Style="{StaticResource Button.TimerPrimary}"
                        ToolTip="{Binding PrimaryButtonTooltip}">
                    <TextBlock Text="{Binding PrimaryButtonIcon}" Style="{StaticResource IconGlyph}" FontSize="26" Foreground="#FFFFFFFF" />
                </Button>

                <Button AutomationProperties.AutomationId="TimerSkipButton"
                        Command="{Binding SkipCommand}"
                        Style="{StaticResource Button.CircleIcon}"
                        ToolTip="{Binding SkipButtonTooltip}"
                        Margin="18,0,0,0">
                    <TextBlock Text="{Binding SkipButtonIcon}" Style="{StaticResource IconGlyph}" FontSize="16" />
                </Button>

                <Button AutomationProperties.AutomationId="TimerAddFiveButton"
                        Command="{Binding AddFiveCommand}"
                        Content="＋5 分钟"
                        Style="{StaticResource Button.Secondary}"
                        Height="36"
                        MinWidth="84"
                        Padding="14,0"
                        Margin="14,0,0,0"
                        themes:ControlProps.CornerRadius="18"
                        Visibility="{Binding IsStopwatch, Converter={StaticResource InvBoolToVis}}" />
            </StackPanel>

            <!-- 4. Current Task Binding Pill -->
            <Grid x:Name="TaskSelectorRow" Grid.Row="3" Margin="0,18,0,0" HorizontalAlignment="Center">
                <Border x:Name="TaskSelectorPill"
                        MaxWidth="420"
                        MinWidth="260"
                        Height="40"
                        CornerRadius="20"
                        Background="{DynamicResource Surface.1}"
                        BorderBrush="{DynamicResource Stroke.Subtle}"
                        BorderThickness="1"
                        Padding="14,0,10,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                AutomationProperties.AutomationId="CurrentTaskSelector"
                                Command="{Binding OpenTaskSelectorCommand}"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                HorizontalContentAlignment="Stretch">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <ContentPresenter VerticalAlignment="Center" />
                                </ControlTemplate>
                            </Button.Template>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{StaticResource Icon.NavTasks}"
                                           Style="{StaticResource IconGlyph}"
                                           FontSize="14"
                                           Foreground="{DynamicResource Phase.StartBrush}"
                                           Margin="0,0,8,0" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding ActiveTaskTitle}"
                                           ToolTip="{Binding ActiveTaskTitle}"
                                           FontSize="13.5"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasActiveTask}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Border Grid.Column="2"
                                        Height="20"
                                        CornerRadius="6"
                                        Padding="7,0"
                                        Margin="8,0,4,0"
                                        Background="{DynamicResource Phase.SoftBrush}"
                                        Visibility="{Binding HasActiveTask, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding ActiveTaskProgressText}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Phase.StartBrush}"
                                               Typography.NumeralAlignment="Tabular"
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="3"
                                           Text="{StaticResource Icon.ChevronDown}"
                                           Style="{StaticResource IconGlyph}"
                                           FontSize="10"
                                           Foreground="{DynamicResource Text.Tertiary}"
                                           Margin="4,0,2,0" />
                            </Grid>
                        </Button>
                        <Button Grid.Column="1"
                                Command="{Binding ClearActiveTaskCommand}"
                                Style="{StaticResource Button.Ghost}"
                                Width="24"
                                Height="24"
                                MinWidth="24"
                                Padding="0"
                                Margin="4,0,0,0"
                                ToolTip="取消关联任务"
                                themes:ControlProps.CornerRadius="999"
                                Visibility="{Binding HasActiveTask, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{StaticResource Icon.Close}" Style="{StaticResource IconGlyph}" FontSize="10" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Task Picker Popup -->
                <Popup IsOpen="{Binding IsTaskPopupOpen, Mode=TwoWay}"
                       PlacementTarget="{Binding ElementName=TaskSelectorPill}"
                       Placement="Top"
                       VerticalOffset="-6"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       PopupAnimation="Fade">
                    <Border Width="360"
                            MaxHeight="320"
                            Background="{DynamicResource Surface.Solid}"
                            BorderBrush="{DynamicResource Stroke.Strong}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="12"
                            Margin="8">
                        <Border.Effect>
                            <DropShadowEffect Color="{DynamicResource Shadow.Color}" BlurRadius="24" ShadowDepth="6" Opacity="{DynamicResource Shadow.Opacity}" />
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBox Grid.Row="0"
                                     Text="{Binding TaskPopupSearch, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource AppTextBox}"
                                     Height="34"
                                     themes:ControlProps.Placeholder="搜索进行中的任务…"
                                     Margin="0,0,0,8" />
                            <ScrollViewer Grid.Row="1" MaxHeight="190" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding PopupTasks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.SelectTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Id}"
                                                    Style="{StaticResource Button.Ghost}"
                                                    Height="36"
                                                    HorizontalContentAlignment="Stretch"
                                                    Padding="8,0"
                                                    Margin="0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding Title}"
                                                               Foreground="{DynamicResource Text.Primary}"
                                                               FontWeight="Normal"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1"
                                                               FontSize="11.5"
                                                               Foreground="{DynamicResource Text.Tertiary}"
                                                               Margin="8,0,0,0"
                                                               VerticalAlignment="Center">
                                                        <Run Text="{Binding CompletedPomodoros, Mode=OneWay}" /><Run Text="/" /><Run Text="{Binding EstimatedPomodoros, Mode=OneWay}" />
                                                    </TextBlock>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <Border Grid.Row="2" BorderBrush="{DynamicResource Stroke.Subtle}" BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,8,0,0">
                                <Grid>
                                    <Button Content="不关联任务" Command="{Binding ClearActiveTaskCommand}" Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left" />
                                    <Button Content="＋ 新建任务" Command="{Binding CreateTaskFromPopupCommand}" Style="{StaticResource Button.Ghost}" Foreground="{DynamicResource Accent}" HorizontalAlignment="Right" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Popup>
            </Grid>
        </Grid>

        <!-- Right Auxiliary Rail (Standard width >= 980) -->
        <Grid x:Name="RightRailPanel" Grid.Row="0" Grid.Column="1" Margin="8,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Card 1: Today Goal -->
            <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="今日目标" Style="{StaticResource Text.CardTitle}" HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding TodayGoalCountText}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Phase.StartBrush}"
                                   Typography.NumeralAlignment="Tabular"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <Grid Height="8" Margin="0,0,0,8">
                        <Border CornerRadius="4" Background="{DynamicResource Ring.Track}" />
                        <ProgressBar Value="{Binding TodayGoalPercent, Mode=OneWay}" Maximum="100" Height="8" Background="Transparent" BorderThickness="0">
                            <ProgressBar.Template>
                                <ControlTemplate TargetType="ProgressBar">
                                    <Grid x:Name="PART_Track">
                                        <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="4" Background="{DynamicResource Phase.Gradient}" />
                                    </Grid>
                                </ControlTemplate>
                            </ProgressBar.Template>
                        </ProgressBar>
                    </Grid>
                    <TextBlock Text="{Binding TodayGoalSubText}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <!-- Card 2: Today Focus Records -->
            <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="今日专注记录" Style="{StaticResource Text.CardTitle}" HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding TodayRecordsCountText}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding HasTodayRecords, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding TodayRecords}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" Background="{DynamicResource Surface.2}" Padding="10,8" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Grid.Column="0" Width="6" Height="6" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{DynamicResource Phase.StartBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsInterrupted}" Value="True">
                                                                <Setter Property="Fill" Value="{DynamicResource Text.Tertiary}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Title}"
                                                           ToolTip="{Binding Title}"
                                                           FontSize="12.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Text.Primary}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding TimeRange}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource Text.Tertiary}"
                                                           Typography.NumeralAlignment="Tabular" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding DurationText}"
                                                       FontSize="11.5"
                                                       Foreground="{DynamicResource Text.Secondary}"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <StackPanel Grid.Row="1"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Visibility="{Binding HasTodayRecords, Converter={StaticResource InvBoolToVis}}">
                        <TextBlock Text="还没有专注记录" Style="{StaticResource TextStyle.Secondary}" HorizontalAlignment="Center" Margin="0,0,0,4" />
                        <TextBlock Text="开始你的第一个番茄吧" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Card 3: Quick Ambient Audio Bar -->
            <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="16">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="环境音" Style="{StaticResource Text.CardTitle}" />
                            <TextBlock Text="{Binding Main.AudioVM.QuickStatusSummary}" Style="{StaticResource Text.Caption}" Margin="8,2,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Command="{Binding Main.AudioVM.ToggleMuteCommand}"
                                    Style="{StaticResource Button.Ghost}"
                                    Width="26"
                                    Height="26"
                                    MinWidth="26"
                                    Padding="0"
                                    Margin="0,0,2,0"
                                    ToolTip="一键静音 / 取消静音">
                                <TextBlock FontSize="12.5">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource IconGlyph}">
                                            <Setter Property="Text" Value="{StaticResource Icon.Volume}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Main.AudioVM.IsMasterMuted}" Value="True">
                                                    <Setter Property="Text" Value="{StaticResource Icon.Mute}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                            <Button Content="更多 ▸" Command="{Binding GoToAudioPageCommand}" Style="{StaticResource Button.Ghost}" Height="26" Padding="6,0" />
                        </StackPanel>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Main.AudioVM.QuickTracks}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.ToggleQuickSoundCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding Id}"
                                        ToolTip="{Binding Name}"
                                        Height="48"
                                        Margin="3,0"
                                        Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border CornerRadius="12" SnapsToDevicePixels="True">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource Surface.2}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Stroke.Subtle}" />
                                                        <Setter Property="BorderThickness" Value="1" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter Property="Background" Value="{Binding ActiveBgBrush}" />
                                                                <Setter Property="BorderBrush" Value="{Binding TintBorderBrush}" />
                                                                <Setter Property="BorderThickness" Value="1.5" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Path Data="{Binding GeometryKey, Converter={StaticResource GeoConverter}}"
                                                          Width="16"
                                                          Height="16"
                                                          Stretch="Uniform"
                                                          StrokeThickness="1.75"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round"
                                                          HorizontalAlignment="Center">
                                                        <Path.Style>
                                                            <Style TargetType="Path">
                                                                <Setter Property="Stroke" Value="{DynamicResource Text.Secondary}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                        <Setter Property="Stroke" Value="{Binding TintBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Path.Style>
                                                    </Path>
                                                    <TextBlock Text="{Binding ShortName}" FontSize="10.5" HorizontalAlignment="Center" Margin="0,3,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                        <Setter Property="Foreground" Value="{Binding TintBrush}" />
                                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Compact Bottom Dual Cards (Width < 980 DIP) -->
        <Grid x:Name="CompactBottomCards" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Height="92" Margin="0,12,0,0" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="14,10">
                <StackPanel VerticalAlignment="Center">
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="今日目标" Style="{StaticResource Text.CardTitle}" FontSize="13.5" HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding TodayGoalCountText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Phase.StartBrush}" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid Height="6" Margin="0,0,0,5">
                        <Border CornerRadius="3" Background="{DynamicResource Ring.Track}" />
                        <ProgressBar Value="{Binding TodayGoalPercent, Mode=OneWay}" Maximum="100" Height="6" Background="Transparent" BorderThickness="0">
                            <ProgressBar.Template>
                                <ControlTemplate TargetType="ProgressBar">
                                    <Grid x:Name="PART_Track">
                                        <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="3" Background="{DynamicResource Phase.Gradient}" />
                                    </Grid>
                                </ControlTemplate>
                            </ProgressBar.Template>
                        </ProgressBar>
                    </Grid>
                    <TextBlock Text="{Binding TodayGoalSubText}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="14,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="快捷环境音" Style="{StaticResource Text.CardTitle}" FontSize="13.5" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Main.AudioVM.QuickStatusSummary}" Style="{StaticResource Text.Caption}" FontSize="11" Margin="8,1,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Content="全部 ▸" Command="{Binding GoToAudioPageCommand}" Style="{StaticResource Button.Ghost}" Height="22" Padding="6,0" HorizontalAlignment="Right" />
                    </Grid>
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Main.AudioVM.QuickTracks}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.ToggleQuickSoundCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding Id}"
                                        ToolTip="{Binding Name}"
                                        Height="28"
                                        Margin="2,0"
                                        Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border CornerRadius="8" SnapsToDevicePixels="True">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource Surface.2}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Stroke.Subtle}" />
                                                        <Setter Property="BorderThickness" Value="1" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter Property="Background" Value="{Binding ActiveBgBrush}" />
                                                                <Setter Property="BorderBrush" Value="{Binding TintBorderBrush}" />
                                                                <Setter Property="BorderThickness" Value="1.5" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding ShortName}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                    <Setter Property="Foreground" Value="{Binding TintBrush}" />
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
