<UserControl x:Class="PomodoroFocus.App.Views.StatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PomodoroFocus.App.Controls"
             xmlns:charts="clr-namespace:PomodoroFocus.App.Controls.Charts"
             xmlns:vm="clr-namespace:PomodoroFocus.App.ViewModels">
    <UserControl.Resources>
        <vm:BoolToVisConverter x:Key="BoolToVis" />
        <vm:BoolToVisConverter x:Key="InvBoolToVis" Invert="True" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="{Binding Main.PageHorizontalPadding}">
            <!-- Header -->
            <Grid Margin="0,0,0,12">
                <TextBlock Text="统计" Style="{StaticResource Text.PageTitle}" HorizontalAlignment="Left" />
                <Button Command="{Binding ExportCsvCommand}" Style="{StaticResource Button.Secondary}" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{StaticResource Icon.Export}" Style="{StaticResource IconGlyph}" FontSize="13" Margin="0,0,6,0" />
                        <TextBlock Text="导出 CSV" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Empty State Banner if zero sessions -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12" Visibility="{Binding HasAnyData, Converter={StaticResource InvBoolToVis}}">
                <TextBlock Text="暂无数据，完成一个番茄后这里会出现你的专注轨迹" Style="{StaticResource TextStyle.Secondary}" HorizontalAlignment="Center" />
            </Border>

            <!-- 1. KPI 4 Cards -->
            <UniformGrid Columns="4" Margin="0,0,0,12">
                <Border Style="{StaticResource CardBorder}" Padding="14,12" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="今日专注" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding TodayPomodorosBig}" Style="{StaticResource Text.KPI}" FontSize="25" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding TodayDurationSub}" Style="{StaticResource TextStyle.Secondary}" FontSize="12" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Padding="14,12" Margin="5,0">
                    <StackPanel>
                        <TextBlock Text="本周专注" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                            <TextBlock Text="{Binding WeekHoursBig}" Style="{StaticResource Text.KPI}" FontSize="25" />
                            <TextBlock Text=" 小时" Style="{StaticResource TextStyle.Secondary}" VerticalAlignment="Bottom" Margin="2,0,0,3" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0" VerticalAlignment="Center">
                            <Border CornerRadius="6" Padding="6,2">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#2230D158" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsWeekDeltaPositive}" Value="False">
                                                <Setter Property="Background" Value="#22FF453A" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding WeekDeltaBadgeText}" FontSize="11" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource Success}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsWeekDeltaPositive}" Value="False">
                                                    <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                            <TextBlock Text="较上周" Style="{StaticResource Text.Caption}" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Padding="14,12" Margin="5,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="连续专注" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                            <Path Data="{StaticResource Geo.flame}" Width="12" Height="12" Stretch="Uniform" Stroke="{DynamicResource Warning}" StrokeThickness="1.8" Margin="5,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding StreakDaysBig}" Style="{StaticResource Text.KPI}" FontSize="25" />
                        <TextBlock Text="{Binding LongestStreakSub}" Style="{StaticResource TextStyle.Secondary}" FontSize="12" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Padding="14,12" Margin="10,0,0,0">
                    <StackPanel>
                        <TextBlock Text="累计专注" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                            <TextBlock Text="{Binding TotalHoursBig}" Style="{StaticResource Text.KPI}" FontSize="25" />
                            <TextBlock Text=" 小时" Style="{StaticResource TextStyle.Secondary}" VerticalAlignment="Bottom" Margin="2,0,0,3" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0" VerticalAlignment="Center">
                            <Border CornerRadius="6" Padding="6,2" Background="{DynamicResource Accent.Soft}">
                                <TextBlock Text="{Binding CompletionRateBadgeText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Typography.NumeralAlignment="Tabular" />
                            </Border>
                            <TextBlock Text="{Binding TotalPomodorosSubText}" Style="{StaticResource Text.Caption}" Margin="6,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- 2. Trend Bar Chart + Distribution Donut Chart -->
            <Grid x:Name="ChartsTopGrid" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="DonutGapCol" Width="12" />
                    <ColumnDefinition x:Name="DonutCol" Width="320" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardBorder}" Padding="16,14">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="专注趋势" Style="{StaticResource Text.CardTitle}" VerticalAlignment="Center" />
                            <controls:SegmentedControl Width="148"
                                                       SegmentHeight="26"
                                                       HorizontalAlignment="Right"
                                                       Items="{Binding TrendRangeOptions}"
                                                       SelectedKey="{Binding TrendRangeKey, Mode=TwoWay}" />
                        </Grid>
                        <charts:TrendBarChart Points="{Binding TrendPoints}" GoalMinutes="{Binding GoalMinutes}" Height="168" MinHeight="168" />
                    </StackPanel>
                </Border>

                <Border x:Name="DonutCard" Grid.Row="0" Grid.Column="2" Style="{StaticResource CardBorder}" Padding="16,14">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="专注分布" Style="{StaticResource Text.CardTitle}" VerticalAlignment="Center" />
                            <controls:SegmentedControl Width="116"
                                                       SegmentHeight="26"
                                                       HorizontalAlignment="Right"
                                                       Items="{Binding DistributionModeOptions}"
                                                       SelectedKey="{Binding DistributionModeKey, Mode=TwoWay}" />
                        </Grid>
                        <charts:DistributionDonutChart Slices="{Binding DistributionSlices}" Height="168" MinHeight="168" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 3. 24-Hour Area Chart -->
            <Border Style="{StaticResource CardBorder}" Padding="16,14" Margin="0,0,0,12">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="专注时段分布" Style="{StaticResource Text.CardTitle}" HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding HourlyPeakSubtitle}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Phase.StartBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <charts:HourlyAreaChart HourMinutes="{Binding HourlyMinutes}" Height="124" MinHeight="124" />
                </StackPanel>
            </Border>

            <!-- 4. Focus Heatmap -->
            <Border Style="{StaticResource CardBorder}" Padding="16,14" Margin="0,0,0,12">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="{Binding HeatmapTitle}" Style="{StaticResource Text.CardTitle}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <controls:SegmentedControl Width="148"
                                                       SegmentHeight="26"
                                                       Items="{Binding HeatmapRangeOptions}"
                                                       SelectedKey="{Binding HeatmapRangeKey, Mode=TwoWay}"
                                                       Margin="0,0,14,0" />
                            <TextBlock Text="少" Style="{StaticResource Text.Micro}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <Border Width="11" Height="11" CornerRadius="2.5" Background="{DynamicResource Heat.L0}" Margin="1.5,0" />
                            <Border Width="11" Height="11" CornerRadius="2.5" Background="{DynamicResource Heat.L1}" Margin="1.5,0" />
                            <Border Width="11" Height="11" CornerRadius="2.5" Background="{DynamicResource Heat.L2}" Margin="1.5,0" />
                            <Border Width="11" Height="11" CornerRadius="2.5" Background="{DynamicResource Heat.L3}" Margin="1.5,0" />
                            <Border Width="11" Height="11" CornerRadius="2.5" Background="{DynamicResource Heat.L4}" Margin="1.5,0" />
                            <TextBlock Text="多" Style="{StaticResource Text.Micro}" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <charts:FocusHeatmapControl x:Name="HeatmapControl"
                                                Cells="{Binding HeatmapCells}"
                                                TargetWeeks="{Binding HeatmapWeeksCount}" />
                </StackPanel>
            </Border>

            <!-- 5. History Detail Records -->
            <Border Style="{StaticResource CardBorder}" Padding="16,14" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="历史记录" Style="{StaticResource Text.CardTitle}" VerticalAlignment="Center" />
                        <controls:SegmentedControl Width="184"
                                                   SegmentHeight="28"
                                                   HorizontalAlignment="Right"
                                                   Items="{Binding HistoryFilterOptions}"
                                                   SelectedKey="{Binding HistoryFilterKey, Mode=TwoWay}" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding HistoryGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Text="{Binding HeaderText}" Style="{StaticResource Text.Caption}" FontWeight="SemiBold" Margin="2,0,0,6" />
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource Stroke.Subtle}" BorderThickness="0,0,0,1" Padding="6,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="96" />
                                                            <ColumnDefinition Width="58" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="52" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding TimeRange}" Style="{StaticResource Text.Caption}" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" />
                                                        <Border Grid.Column="1" Height="20" CornerRadius="6" Padding="6,0" HorizontalAlignment="Left" Background="{DynamicResource Accent.Soft}">
                                                            <TextBlock Text="{Binding PhaseBadge}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
                                                        </Border>
                                                        <TextBlock Grid.Column="2" Text="{Binding TaskTitle}" ToolTip="{Binding TaskTitle}" Style="{StaticResource Text.Body}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="6,0" />
                                                        <TextBlock Grid.Column="3" Text="{Binding DurationText}" Style="{StaticResource TextStyle.Secondary}" FontSize="12" VerticalAlignment="Center" Margin="8,0" />
                                                        <TextBlock Grid.Column="4" Text="{Binding OutcomeText}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Success}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsInterrupted}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource Text.Tertiary}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <Button Grid.Column="5"
                                                                Command="{Binding DataContext.DeleteSessionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding Id}"
                                                                Style="{StaticResource Button.Ghost}"
                                                                Width="28"
                                                                Height="28"
                                                                MinWidth="28"
                                                                Padding="0"
                                                                Margin="8,0,0,0"
                                                                ToolTip="删除此记录"
                                                                Opacity="0.6">
                                                            <TextBlock Text="{StaticResource Icon.Delete}" Style="{StaticResource IconGlyph}" FontSize="12" />
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Content="加载更多"
                            Command="{Binding LoadMoreHistoryCommand}"
                            Style="{StaticResource Button.Secondary}"
                            HorizontalAlignment="Center"
                            Margin="0,6,0,0"
                            Visibility="{Binding HasMoreHistory, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
