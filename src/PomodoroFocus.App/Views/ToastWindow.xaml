<Window x:Class="PomodoroFocus.App.Views.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="番茄专注"
        Width="372"
        Height="146"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowActivated="False"
        ShowInTaskbar="False"
        ResizeMode="NoResize">

    <Border x:Name="ToastCard"
            Margin="6"
            CornerRadius="16"
            Background="{DynamicResource Surface.Solid}"
            BorderBrush="{DynamicResource Stroke.Strong}"
            BorderThickness="1"
            ClipToBounds="True"
            MouseEnter="OnCardMouseEnter"
            MouseLeave="OnCardMouseLeave">
        <Border.RenderTransform>
            <TranslateTransform x:Name="SlideTransform" X="40" />
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect Color="{DynamicResource Shadow.Color}" BlurRadius="24" ShadowDepth="8" Opacity="{DynamicResource Shadow.Opacity}" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="3" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top 3px Phase Gradient Accent Bar -->
            <Border Grid.Row="0" Background="{DynamicResource Phase.Gradient}" />

            <Grid Grid.Row="1" Margin="16,12,14,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{StaticResource Icon.Bell}" Style="{StaticResource IconGlyph}" FontSize="14" Foreground="{DynamicResource Phase.StartBrush}" Margin="0,0,8,0" />
                        <TextBlock x:Name="ToastTitleText" Style="{StaticResource Text.CardTitle}" />
                    </StackPanel>
                    <Button Click="OnCloseClick" Style="{StaticResource Button.Ghost}" Width="24" Height="24" MinWidth="24" Padding="0" HorizontalAlignment="Right">
                        <TextBlock Text="{StaticResource Icon.Close}" Style="{StaticResource IconGlyph}" FontSize="10" />
                    </Button>
                </Grid>

                <TextBlock x:Name="ToastBodyText"
                           Grid.Row="1"
                           Style="{StaticResource TextStyle.Secondary}"
                           TextWrapping="Wrap"
                           Margin="0,6,0,8" />

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="SecondaryBtn"
                            Click="OnSecondaryClick"
                            Style="{StaticResource Button.Secondary}"
                            Height="30"
                            MinWidth="72"
                            Padding="12,0"
                            FontSize="12.5"
                            Margin="0,0,8,0" />
                    <Button x:Name="PrimaryBtn"
                            Click="OnPrimaryClick"
                            Style="{StaticResource Button.Primary}"
                            Height="30"
                            MinWidth="76"
                            Padding="12,0"
                            FontSize="12.5" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
