<Window x:Class="PomodoroFocus.App.Views.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:themes="clr-namespace:PomodoroFocus.App.Themes"
        Title="番茄专注"
        Width="372"
        Height="142"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowActivated="False"
        ShowInTaskbar="False"
        ResizeMode="NoResize">

    <Border x:Name="ToastCard"
            Margin="6"
            CornerRadius="16"
            Background="{DynamicResource Surface.Solid}"
            BorderBrush="{DynamicResource Stroke.Strong}"
            BorderThickness="1"
            Padding="14,12"
            MouseEnter="OnCardMouseEnter"
            MouseLeave="OnCardMouseLeave">
        <Border.RenderTransform>
            <TranslateTransform x:Name="SlideTransform" X="40" />
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect Color="{DynamicResource Shadow.Color}" BlurRadius="28" ShadowDepth="8" Direction="270" Opacity="{DynamicResource Shadow.Opacity}" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top macOS Notification Banner Row -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="36"
                        Height="36"
                        CornerRadius="9"
                        Background="{DynamicResource Phase.Gradient}"
                        VerticalAlignment="Top"
                        Margin="0,2,12,0">
                    <TextBlock Text="{StaticResource Icon.Bell}" Style="{StaticResource IconGlyph}" FontSize="16" Foreground="#FFFFFFFF" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="0,0,8,0">
                    <TextBlock x:Name="ToastTitleText" Style="{StaticResource Text.CardTitle}" />
                    <TextBlock x:Name="ToastBodyText"
                               Style="{StaticResource TextStyle.Secondary}"
                               TextWrapping="Wrap"
                               Margin="0,3,0,0" />
                </StackPanel>

                <Button Grid.Column="2"
                        Click="OnCloseClick"
                        Style="{StaticResource Button.Ghost}"
                        Width="24"
                        Height="24"
                        MinWidth="24"
                        Padding="0"
                        VerticalAlignment="Top">
                    <TextBlock Text="{StaticResource Icon.Close}" Style="{StaticResource IconGlyph}" FontSize="10" />
                </Button>
            </Grid>

            <!-- Bottom Capsule Action Buttons -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button x:Name="SecondaryBtn"
                        Click="OnSecondaryClick"
                        Style="{StaticResource Button.Secondary}"
                        Height="28"
                        MinWidth="72"
                        Padding="12,0"
                        FontSize="12"
                        themes:ControlProps.CornerRadius="14"
                        Margin="0,0,8,0" />
                <Button x:Name="PrimaryBtn"
                        Click="OnPrimaryClick"
                        Style="{StaticResource Button.Primary}"
                        Height="28"
                        MinWidth="76"
                        Padding="12,0"
                        FontSize="12"
                        themes:ControlProps.CornerRadius="14" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
