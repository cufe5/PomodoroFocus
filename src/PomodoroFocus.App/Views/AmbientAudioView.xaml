<UserControl x:Class="PomodoroFocus.App.Views.AmbientAudioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:PomodoroFocus.App.Views"
             xmlns:vm="clr-namespace:PomodoroFocus.App.ViewModels"
             xmlns:themes="clr-namespace:PomodoroFocus.App.Themes">
    <UserControl.Resources>
        <vm:BoolToVisConverter x:Key="BoolToVis" />
        <vm:BoolToVisConverter x:Key="InvBoolToVis" Invert="True" />
        <views:GeoKeyConverter x:Key="GeoConverter" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="{Binding DataContext.PageHorizontalPadding, RelativeSource={RelativeSource AncestorType=Window}}">
            <!-- Audio device error banner -->
            <Border CornerRadius="10"
                    Background="{DynamicResource Surface.2}"
                    BorderBrush="{DynamicResource Warning}"
                    BorderThickness="3,1,1,1"
                    Padding="12,10"
                    Margin="0,0,0,14"
                    Visibility="{Binding IsAudioDeviceAvailable, Converter={StaticResource InvBoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{StaticResource Icon.Warning}" Style="{StaticResource IconGlyph}" Foreground="{DynamicResource Warning}" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding AudioDeviceError}" Style="{StaticResource Text.Body}" />
                </StackPanel>
            </Border>

            <!-- 1. Header + Master Volume -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="环境音" Style="{StaticResource Text.PageTitle}" />
                    <TextBlock Text="全部由本地实时合成，离线可用" Style="{StaticResource TextStyle.Secondary}" Margin="0,2,0,0" />
                </StackPanel>

                <Border Grid.Column="1"
                        CornerRadius="12"
                        Background="{DynamicResource Surface.1}"
                        BorderBrush="{DynamicResource Stroke.Subtle}"
                        BorderThickness="1"
                        Padding="12,6"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="主音量" Style="{StaticResource Text.Caption}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <Button Command="{Binding ToggleMuteCommand}"
                                Style="{StaticResource Button.Ghost}"
                                Width="30"
                                Height="30"
                                MinWidth="30"
                                Padding="0"
                                ToolTip="静音 / 取消静音">
                            <TextBlock FontSize="15">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource IconGlyph}">
                                        <Setter Property="Text" Value="{StaticResource Icon.Volume}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMasterMuted}" Value="True">
                                                <Setter Property="Text" Value="{StaticResource Icon.Mute}" />
                                                <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                        <Slider Value="{Binding MasterVolume, Mode=TwoWay}"
                                Minimum="0"
                                Maximum="100"
                                Width="140"
                                Margin="6,0,8,0"
                                Style="{StaticResource AppSlider}" />
                        <TextBlock Text="{Binding MasterVolumeText}"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text.Primary}"
                                   Typography.NumeralAlignment="Tabular"
                                   Width="36"
                                   TextAlignment="Right"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 2. Presets, Sleep Timer, Linkage Rules -->
            <Border Style="{StaticResource CardBorder}" Padding="16,14" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="预设场景" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <ItemsControl ItemsSource="{Binding Presets}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Cursor="Hand"
                                                Margin="0,2,8,2">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Height="30" CornerRadius="8" Padding="12,0" BorderThickness="1">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource Surface.2}" />
                                                                <Setter Property="BorderBrush" Value="{DynamicResource Stroke.Subtle}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource Accent.Soft}" />
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding Label}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="全部停止"
                                    Command="{Binding StopAllCommand}"
                                    Style="{StaticResource Button.Ghost}"
                                    Height="30"
                                    Margin="2,2,0,2"
                                    themes:ControlProps.CornerRadius="8" />
                        </WrapPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock Text="定时关闭" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox ItemsSource="{Binding SleepTimerOptions}"
                                      SelectedItem="{Binding SelectedSleepOption, Mode=TwoWay}"
                                      Style="{StaticResource AppComboBox}"
                                      Width="104"
                                      Height="32" />
                            <TextBlock Text="{Binding SleepRemainingText}"
                                       FontSize="12"
                                       Foreground="{DynamicResource Accent}"
                                       Typography.NumeralAlignment="Tabular"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0"
                                       Visibility="{Binding HasSleepRemaining, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Grid>

                    <Border BorderBrush="{DynamicResource Stroke.Subtle}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,28,0">
                                <ToggleButton IsChecked="{Binding OnlyDuringFocus, Mode=TwoWay}" Style="{StaticResource ToggleSwitch}" Margin="0,0,10,0" />
                                <TextBlock Text="仅在专注时播放" Style="{StaticResource Text.Body}" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ToggleButton IsChecked="{Binding MuteOnPause, Mode=TwoWay}" Style="{StaticResource ToggleSwitch}" Margin="0,0,10,0" />
                                <TextBlock Text="暂停计时时静音" Style="{StaticResource Text.Body}" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 3. 3x3 Sound Cards Grid -->
            <ItemsControl ItemsSource="{Binding Tracks}" IsEnabled="{Binding IsAudioDeviceAvailable}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Height="126"
                                CornerRadius="16"
                                Margin="6"
                                Padding="16,14"
                                SnapsToDevicePixels="True">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource Surface.1}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource Stroke.Subtle}" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter Property="Background" Value="{Binding ActiveBgBrush}" />
                                            <Setter Property="BorderBrush" Value="{Binding TintBorderBrush}" />
                                            <Setter Property="BorderThickness" Value="1" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Top clickable region toggles track -->
                                <Button Grid.Row="0"
                                        AutomationProperties.AutomationId="{Binding AutomationId}"
                                        Command="{Binding DataContext.ToggleTrackCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Top">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="Transparent">
                                                <ContentPresenter />
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Circular Lucide Icon (iOS Control Center solid tinted disc when active) -->
                                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="999" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource Surface.2}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Background" Value="{Binding TintBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Path Data="{Binding GeometryKey, Converter={StaticResource GeoConverter}}"
                                                  Width="20"
                                                  Height="20"
                                                  Stretch="Uniform"
                                                  StrokeThickness="1.75"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Stroke" Value="{DynamicResource Text.Secondary}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter Property="Stroke" Value="#FFFFFFFF" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                        </Border>

                                        <!-- Name & Status -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Text.CardTitle}" FontSize="14.5" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding StatusText}" FontSize="11.5" Margin="0,3,0,0" TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource Text.Tertiary}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter Property="Foreground" Value="{Binding TintBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- Active Waveform Indicator -->
                                        <StackPanel Grid.Column="2"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Top"
                                                    Margin="4,4,0,0"
                                                    Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                            <Border Width="3" Height="8" CornerRadius="1.5" Background="{Binding TintBrush}" Margin="1,0" VerticalAlignment="Bottom" />
                                            <Border Width="3" Height="14" CornerRadius="1.5" Background="{Binding TintBrush}" Margin="1,0" VerticalAlignment="Bottom" />
                                            <Border Width="3" Height="10" CornerRadius="1.5" Background="{Binding TintBrush}" Margin="1,0" VerticalAlignment="Bottom" />
                                            <Border Width="3" Height="6" CornerRadius="1.5" Background="{Binding TintBrush}" Margin="1,0" VerticalAlignment="Bottom" />
                                        </StackPanel>
                                    </Grid>
                                </Button>

                                <!-- Bottom Volume Slider (muted gray rail when inactive, vivid tint when active) -->
                                <Slider Grid.Row="1"
                                        Value="{Binding Volume, Mode=TwoWay}"
                                        Minimum="0"
                                        Maximum="100"
                                        Margin="0,10,0,0">
                                    <Slider.Style>
                                        <Style TargetType="Slider" BasedOn="{StaticResource AppSlider}">
                                            <Setter Property="Foreground" Value="{DynamicResource Switch.Off}" />
                                            <Setter Property="Opacity" Value="0.28" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Foreground" Value="{Binding TintBrush}" />
                                                    <Setter Property="Opacity" Value="1.0" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Slider.Style>
                                </Slider>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
