<UserControl x:Class="PomodoroFocus.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PomodoroFocus.App.Controls"
             xmlns:vm="clr-namespace:PomodoroFocus.App.ViewModels">
    <UserControl.Resources>
        <vm:BoolToVisConverter x:Key="BoolToVis" />
        <vm:BoolToVisConverter x:Key="InvBoolToVis" Invert="True" />

        <Style x:Key="SettingRowBorder" TargetType="Border">
            <Setter Property="MinHeight" Value="54" />
            <Setter Property="BorderBrush" Value="{DynamicResource Stroke.Subtle}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="0,8" />
        </Style>

        <Style x:Key="SettingLastRowBorder" TargetType="Border">
            <Setter Property="MinHeight" Value="52" />
            <Setter Property="Padding" Value="0,8,0,0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="760" HorizontalAlignment="Stretch" Margin="{Binding DataContext.PageHorizontalPadding, RelativeSource={RelativeSource AncestorType=Window}}">
            <TextBlock Text="设置" Style="{StaticResource Text.PageTitle}" Margin="0,0,0,18" />

            <!-- 1. Appearance -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBlock Text="{StaticResource Icon.Theme}" Style="{StaticResource IconGlyph}" FontSize="16" Foreground="{DynamicResource Accent}" Margin="0,0,8,0" />
                        <TextBlock Text="外观" Style="{StaticResource Text.SectionTitle}" />
                    </StackPanel>

                    <TextBlock Text="主题风格" Style="{StaticResource Text.BodyStrong}" Margin="0,0,0,10" />
                    <ItemsControl ItemsSource="{Binding ThemeCards}" Margin="0,0,0,14">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button AutomationProperties.AutomationId="{Binding AutomationId}"
                                        Command="{Binding DataContext.SelectThemeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding Key}"
                                        Cursor="Hand"
                                        Margin="0,0,10,0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Height="92" CornerRadius="12" Padding="8" Background="{Binding BgHex}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Stroke.Strong}" />
                                                        <Setter Property="BorderThickness" Value="1" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                                                                <Setter Property="BorderThickness" Value="2" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <!-- Mini Window Preview -->
                                                    <Grid Grid.Row="0" Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="22" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" CornerRadius="4" Background="{Binding CardHex}" Margin="0,0,4,0" />
                                                        <Border Grid.Column="1" CornerRadius="4" Background="{Binding CardHex}" Padding="6">
                                                            <Ellipse Width="20" Height="20" Stroke="{Binding AccentHex}" StrokeThickness="2.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <!-- Selected Check Badge -->
                                                        <Border Grid.Column="1"
                                                                Width="18"
                                                                Height="18"
                                                                CornerRadius="999"
                                                                Background="{Binding AccentHex}"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Top"
                                                                Margin="0,-2,-2,0"
                                                                Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="{StaticResource Icon.Check}" Style="{StaticResource IconGlyph}" FontSize="10" Foreground="#FFFFFFFF" />
                                                        </Border>
                                                    </Grid>
                                                    <TextBlock Grid.Row="1"
                                                               Text="{Binding DisplayName}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{Binding TextHex}"
                                                               HorizontalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Style="{StaticResource SettingRowBorder}">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="减少动态效果" Style="{StaticResource Text.BodyStrong}" />
                                <TextBlock Text="关闭粒子庆祝、呼吸光晕与主题渐变过渡动画" Style="{StaticResource Text.Caption}" />
                            </StackPanel>
                            <ToggleButton IsChecked="{Binding ReduceMotion, Mode=TwoWay}" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingLastRowBorder}">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="迷你窗不透明度" Style="{StaticResource Text.BodyStrong}" />
                                <TextBlock Text="调整置顶迷你悬浮窗的透明度（70% – 100%）" Style="{StaticResource Text.Caption}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Slider Value="{Binding MiniOpacityPercent, Mode=TwoWay}" Minimum="70" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Width="136" Style="{StaticResource AppSlider}" />
                                <TextBlock Text="{Binding MiniOpacityText}" Style="{StaticResource Text.BodyStrong}" Typography.NumeralAlignment="Tabular" Width="42" TextAlignment="Right" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 2. Timer -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{StaticResource Icon.NavFocus}" Style="{StaticResource IconGlyph}" FontSize="16" Foreground="{DynamicResource Accent}" Margin="0,0,8,0" />
                            <TextBlock Text="计时" Style="{StaticResource Text.SectionTitle}" />
                        </StackPanel>
                        <TextBlock Text="将在下一个阶段生效"
                                   FontSize="12"
                                   Foreground="{DynamicResource Warning}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding ShowNextPhaseHint, Converter={StaticResource BoolToVis}}" />
                    </Grid>

                    <Border Style="{StaticResource SettingRowBorder}">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="专注时长（分钟）" Style="{StaticResource Text.BodyStrong}" />
                                <TextBlock Text="每个标准番茄专注阶段的默认时长" Style="{StaticResource Text.Caption}" />
                            </StackPanel>
                            <controls:NumberStepper Value="{Binding FocusMinutes, Mode=TwoWay}" Minimum="1" Maximum="180" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SettingRowBorder}">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="短休息时长（分钟）" Style="{StaticResource Text.BodyStrong}" />
                                <TextBlock Text="单个番茄完成后的放松时长" Style="{StaticResource Text.Caption}" />
                            </StackPanel>
                            <controls:NumberStepper Value="{Binding ShortBreakMinutes, Mode=TwoWay}" Minimum="1" Maximum="60" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SettingRowBorder}">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="长休息时长（分钟）" Style="{StaticResource Text.BodyStrong}" />
                                <TextBlock Text="完成一整轮番茄周期后的深度恢复时长" Style="{StaticResource Text.Caption}" />
                            </StackPanel>
                            <controls:NumberStepper Value="{Binding LongBreakMinutes, Mode=TwoWay}" Minimum="1" Maximum="120" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SettingRowBorder}">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="长休息间隔（个番茄）" Style="{StaticResource Text.BodyStrong}" />
                                <TextBlock Text="每完成指定数量专注后自动进入长休息" Style="{StaticResource Text.Caption}" />
                            </StackPanel>
                            <controls:NumberStepper Value="{Binding LongBreakInterval, Mode=TwoWay}" Minimum="2" Maximum="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SettingRowBorder}">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="每日目标（个番茄）" Style="{StaticResource Text.BodyStrong}" />
                                <TextBlock Text="用于今日进度条与统计趋势目标虚线" Style="{StaticResource Text.Caption}" />
                            </StackPanel>
                            <controls:NumberStepper Value="{Binding DailyGoal, Mode=TwoWay}" Minimum="1" Maximum="24" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SettingLastRowBorder}">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="新一天起点" Style="{StaticResource Text.BodyStrong}" />
                                <TextBlock Text="凌晨此时间之前的专注记录将归入前一天统计" Style="{StaticResource Text.Caption}" />
                            </StackPanel>
                            <ComboBox ItemsSource="{Binding DayStartOptions}" SelectedItem="{Binding SelectedDayStart, Mode=TwoWay}" Style="{StaticResource AppComboBox}" Width="128" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 3. Automation -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="自动化" Style="{StaticResource Text.SectionTitle}" Margin="0,0,0,10" />
                    <Border Style="{StaticResource SettingRowBorder}">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="专注结束后自动开始休息" Style="{StaticResource Text.BodyStrong}" />
                                <TextBlock Text="专注倒计时归零后无需点击立即开始休息" Style="{StaticResource Text.Caption}" />
                            </StackPanel>
                            <ToggleButton IsChecked="{Binding AutoStartBreaks, Mode=TwoWay}" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SettingRowBorder}">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="休息结束后自动开始专注" Style="{StaticResource Text.BodyStrong}" />
                                <TextBlock Text="短休或长休结束后自动进入下一个番茄" Style="{StaticResource Text.Caption}" />
                            </StackPanel>
                            <ToggleButton IsChecked="{Binding AutoStartFocus, Mode=TwoWay}" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SettingRowBorder}">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="启动时恢复上次未完成的计时" Style="{StaticResource Text.BodyStrong}" />
                                <TextBlock Text="异常退出或重启后继续恢复进行中/已暂停的阶段" Style="{StaticResource Text.Caption}" />
                            </StackPanel>
                            <ToggleButton IsChecked="{Binding RestoreTimerOnLaunch, Mode=TwoWay}" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SettingLastRowBorder}">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="打开迷你窗时隐藏主窗口" Style="{StaticResource Text.BodyStrong}" />
                                <TextBlock Text="进入迷你悬浮模式时自动收起主窗口减少桌面遮挡" Style="{StaticResource Text.Caption}" />
                            </StackPanel>
                            <ToggleButton IsChecked="{Binding HideMainOnMini, Mode=TwoWay}" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 4. Notifications & Sound -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="{StaticResource Icon.Bell}" Style="{StaticResource IconGlyph}" FontSize="16" Foreground="{DynamicResource Accent}" Margin="0,0,8,0" />
                        <TextBlock Text="提醒与声音" Style="{StaticResource Text.SectionTitle}" />
                    </StackPanel>
                    <Border Style="{StaticResource SettingRowBorder}">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="阶段结束提示音" Style="{StaticResource Text.BodyStrong}" />
                                <TextBlock Text="纯本地实时合成，支持一键试听" Style="{StaticResource Text.Caption}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <ComboBox ItemsSource="{Binding NotificationSoundOptions}" SelectedItem="{Binding SelectedNotificationSound, Mode=TwoWay}" Style="{StaticResource AppComboBox}" Width="120" Margin="0,0,8,0" />
                                <Button AutomationProperties.AutomationId="PreviewSoundButton" Content="试听" Command="{Binding PreviewSoundCommand}" Style="{StaticResource Button.Secondary}" MinWidth="64" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SettingRowBorder}">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="提示音音量" Style="{StaticResource Text.BodyStrong}" />
                                <TextBlock Text="提示音播放时环境音会自动闪避至 40%" Style="{StaticResource Text.Caption}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Slider Value="{Binding NotificationVolume, Mode=TwoWay}" Minimum="0" Maximum="100" Width="136" Style="{StaticResource AppSlider}" />
                                <TextBlock Text="{Binding NotificationVolumeText}" Style="{StaticResource Text.BodyStrong}" Typography.NumeralAlignment="Tabular" Width="42" TextAlignment="Right" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SettingRowBorder}">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="结束前 1 分钟轻声提醒" Style="{StaticResource Text.BodyStrong}" />
                                <TextBlock Text="倒计时剩余 60 秒时播放一次柔和提示音" Style="{StaticResource Text.Caption}" />
                            </StackPanel>
                            <ToggleButton IsChecked="{Binding OneMinuteWarning, Mode=TwoWay}" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SettingRowBorder}">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="桌面系统通知" Style="{StaticResource Text.BodyStrong}" />
                                <TextBlock Text="通过 Windows 系统通知中心推送阶段完成提醒" Style="{StaticResource Text.Caption}" />
                            </StackPanel>
                            <ToggleButton IsChecked="{Binding EnableDesktopNotification, Mode=TwoWay}" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SettingLastRowBorder}">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="应用内完成卡片提醒" Style="{StaticResource Text.BodyStrong}" />
                                <TextBlock Text="右下角滑入不抢焦点的快捷操作卡片" Style="{StaticResource Text.Caption}" />
                            </StackPanel>
                            <ToggleButton IsChecked="{Binding EnableInAppToast, Mode=TwoWay}" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 5. Global Hotkeys -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{StaticResource Icon.Keyboard}" Style="{StaticResource IconGlyph}" FontSize="16" Foreground="{DynamicResource Accent}" Margin="0,0,8,0" />
                            <TextBlock Text="快捷键" Style="{StaticResource Text.SectionTitle}" />
                        </StackPanel>
                        <Button Content="恢复默认" Command="{Binding RestoreDefaultHotkeysCommand}" Style="{StaticResource Button.Ghost}" HorizontalAlignment="Right" />
                    </Grid>
                    <Border Style="{StaticResource SettingRowBorder}">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="启用全局快捷键" Style="{StaticResource Text.BodyStrong}" />
                                <TextBlock Text="在任意窗口中直接控制番茄钟（点击右侧录制框可修改）" Style="{StaticResource Text.Caption}" />
                            </StackPanel>
                            <ToggleButton IsChecked="{Binding EnableGlobalHotkeys, Mode=TwoWay}" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SettingRowBorder}">
                        <Grid>
                            <TextBlock Text="开始 / 暂停" Style="{StaticResource Text.BodyStrong}" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="已被占用" FontSize="11.5" Foreground="{DynamicResource Warning}" VerticalAlignment="Center" Margin="0,0,8,0" Visibility="{Binding HotkeyToggleOk, Converter={StaticResource InvBoolToVis}}" />
                                <controls:HotkeyRecorderBox GestureText="{Binding HotkeyToggle, Mode=TwoWay}" IsEnabled="{Binding EnableGlobalHotkeys}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SettingRowBorder}">
                        <Grid>
                            <TextBlock Text="跳过当前阶段" Style="{StaticResource Text.BodyStrong}" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="已被占用" FontSize="11.5" Foreground="{DynamicResource Warning}" VerticalAlignment="Center" Margin="0,0,8,0" Visibility="{Binding HotkeySkipOk, Converter={StaticResource InvBoolToVis}}" />
                                <controls:HotkeyRecorderBox GestureText="{Binding HotkeySkip, Mode=TwoWay}" IsEnabled="{Binding EnableGlobalHotkeys}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SettingRowBorder}">
                        <Grid>
                            <TextBlock Text="显示 / 隐藏迷你窗" Style="{StaticResource Text.BodyStrong}" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="已被占用" FontSize="11.5" Foreground="{DynamicResource Warning}" VerticalAlignment="Center" Margin="0,0,8,0" Visibility="{Binding HotkeyMiniOk, Converter={StaticResource InvBoolToVis}}" />
                                <controls:HotkeyRecorderBox GestureText="{Binding HotkeyMini, Mode=TwoWay}" IsEnabled="{Binding EnableGlobalHotkeys}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SettingLastRowBorder}">
                        <Grid>
                            <TextBlock Text="显示 / 隐藏主窗口" Style="{StaticResource Text.BodyStrong}" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="已被占用" FontSize="11.5" Foreground="{DynamicResource Warning}" VerticalAlignment="Center" Margin="0,0,8,0" Visibility="{Binding HotkeyMainOk, Converter={StaticResource InvBoolToVis}}" />
                                <controls:HotkeyRecorderBox GestureText="{Binding HotkeyMain, Mode=TwoWay}" IsEnabled="{Binding EnableGlobalHotkeys}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 6. System & Tray -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="{StaticResource Icon.Power}" Style="{StaticResource IconGlyph}" FontSize="16" Foreground="{DynamicResource Accent}" Margin="0,0,8,0" />
                        <TextBlock Text="系统" Style="{StaticResource Text.SectionTitle}" />
                    </StackPanel>
                    <Border Style="{StaticResource SettingRowBorder}">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="开机自动启动" Style="{StaticResource Text.BodyStrong}" />
                                <TextBlock Text="登录 Windows 时静默启动到系统托盘" Style="{StaticResource Text.Caption}" />
                            </StackPanel>
                            <ToggleButton IsChecked="{Binding LaunchAtStartup, Mode=TwoWay}" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SettingRowBorder}">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="显示系统托盘图标" Style="{StaticResource Text.BodyStrong}" />
                                <TextBlock Text="在任务栏通知区域实时绘制专注进度环并提供右键菜单" Style="{StaticResource Text.Caption}" />
                            </StackPanel>
                            <ToggleButton IsChecked="{Binding ShowTrayIcon, Mode=TwoWay}" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SettingLastRowBorder}">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="关闭主窗口时最小化到托盘" Style="{StaticResource Text.BodyStrong}" />
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                            <Setter Property="Text" Value="点击关闭按钮后继续在后台计时" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CanMinimizeToTray}" Value="False">
                                                    <Setter Property="Text" Value="需开启系统托盘图标后生效（关闭主窗口将直接退出）" />
                                                    <Setter Property="Foreground" Value="{DynamicResource Warning}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <ToggleButton IsChecked="{Binding MinimizeToTrayOnClose, Mode=TwoWay}" IsEnabled="{Binding CanMinimizeToTray}" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 7. Data Management -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="{StaticResource Icon.Folder}" Style="{StaticResource IconGlyph}" FontSize="16" Foreground="{DynamicResource Accent}" Margin="0,0,8,0" />
                        <TextBlock Text="数据" Style="{StaticResource Text.SectionTitle}" />
                    </StackPanel>
                    <Border Style="{StaticResource SettingRowBorder}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="本地数据目录" Style="{StaticResource Text.BodyStrong}" />
                                <TextBlock Text="{Binding DataDirectoryPath}" ToolTip="{Binding DataDirectoryPath}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="打开文件夹" Command="{Binding OpenDataFolderCommand}" Style="{StaticResource Button.Secondary}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SettingRowBorder}">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="备份与导出" Style="{StaticResource Text.BodyStrong}" />
                                <TextBlock Text="纯本地 JSON 全量备份与 CSV 表格导出" Style="{StaticResource Text.Caption}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="导出备份" Command="{Binding ExportBackupCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,0" />
                                <Button Content="导入备份" Command="{Binding ImportBackupCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,0" />
                                <Button Content="导出 CSV" Command="{Binding ExportCsvCommand}" Style="{StaticResource Button.Secondary}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SettingLastRowBorder}">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="重置与清理" Style="{StaticResource Text.BodyStrong}" />
                                <TextBlock Text="恢复默认配置或清空全部历史与任务数据" Style="{StaticResource Text.Caption}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="恢复默认设置" Command="{Binding RestoreDefaultSettingsCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,0" />
                                <Button Content="清空所有数据" Command="{Binding ClearAllDataCommand}" Style="{StaticResource Button.Danger}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 8. About & Shortcuts -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Image Source="{StaticResource Logo}" Width="40" Height="40" Margin="0,0,14,0" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="番茄专注 PomodoroFocus v1.0.0" Style="{StaticResource Text.SectionTitle}" FontSize="16" />
                            <TextBlock Text="纯本地离线 · 零外部依赖 · Windows 桌面专注工具" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <Border BorderBrush="{DynamicResource Stroke.Subtle}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                        <UniformGrid Columns="2">
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <Border Style="{StaticResource KeyCapBorder}" Margin="0,0,8,0"><TextBlock Text="Space" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}" VerticalAlignment="Center" /></Border>
                                <TextBlock Text="开始 / 暂停计时" Style="{StaticResource TextStyle.Secondary}" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <Border Style="{StaticResource KeyCapBorder}" Margin="0,0,8,0"><TextBlock Text="R / S" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}" VerticalAlignment="Center" /></Border>
                                <TextBlock Text="重置 / 跳过当前阶段" Style="{StaticResource TextStyle.Secondary}" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <Border Style="{StaticResource KeyCapBorder}" Margin="0,0,8,0"><TextBlock Text="+ / M" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}" VerticalAlignment="Center" /></Border>
                                <TextBlock Text="延长 5 分钟 / 切换迷你窗" Style="{StaticResource TextStyle.Secondary}" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <Border Style="{StaticResource KeyCapBorder}" Margin="0,0,8,0"><TextBlock Text="Ctrl + 1…5" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}" VerticalAlignment="Center" /></Border>
                                <TextBlock Text="快速切换五个功能页面" Style="{StaticResource TextStyle.Secondary}" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <Border Style="{StaticResource KeyCapBorder}" Margin="0,0,8,0"><TextBlock Text="Ctrl + N" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}" VerticalAlignment="Center" /></Border>
                                <TextBlock Text="快速新建任务" Style="{StaticResource TextStyle.Secondary}" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <Border Style="{StaticResource KeyCapBorder}" Margin="0,0,8,0"><TextBlock Text="Ctrl + F" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}" VerticalAlignment="Center" /></Border>
                                <TextBlock Text="搜索任务列表" Style="{StaticResource TextStyle.Secondary}" VerticalAlignment="Center" />
                            </StackPanel>
                        </UniformGrid>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
