<UserControl x:Class="PomodoroFocus.App.Views.TasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PomodoroFocus.App.Controls"
             xmlns:themes="clr-namespace:PomodoroFocus.App.Themes"
             xmlns:vm="clr-namespace:PomodoroFocus.App.ViewModels">
    <UserControl.Resources>
        <vm:BoolToVisConverter x:Key="BoolToVis" />
        <vm:BoolToVisConverter x:Key="InvBoolToVis" Invert="True" />
    </UserControl.Resources>

    <Grid Margin="{Binding DataContext.PageHorizontalPadding, RelativeSource={RelativeSource AncestorType=Window}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 1. Page Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="任务" Style="{StaticResource Text.PageTitle}" />
                <TextBlock Text="{Binding SubtitleText}" Style="{StaticResource TextStyle.Secondary}" Margin="0,2,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Search Box -->
                <Grid Width="210" Margin="0,0,10,0">
                    <TextBox x:Name="TaskSearchBox"
                             AutomationProperties.AutomationId="TaskSearchBox"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource AppTextBox}"
                             Padding="32,0,28,0"
                             themes:ControlProps.Placeholder="搜索任务…" />
                    <TextBlock Text="{StaticResource Icon.Search}"
                               Style="{StaticResource IconGlyph}"
                               FontSize="13"
                               Foreground="{DynamicResource Text.Tertiary}"
                               HorizontalAlignment="Left"
                               Margin="11,0,0,0"
                               IsHitTestVisible="False" />
                    <Button Command="{Binding ClearSearchCommand}"
                            Style="{StaticResource Button.Ghost}"
                            Width="24"
                            Height="24"
                            MinWidth="24"
                            Padding="0"
                            HorizontalAlignment="Right"
                            Margin="0,0,4,0"
                            Visibility="{Binding HasSearchText, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{StaticResource Icon.Close}" Style="{StaticResource IconGlyph}" FontSize="10" />
                    </Button>
                </Grid>

                <!-- Sort ComboBox -->
                <ComboBox AutomationProperties.AutomationId="TaskSortCombo"
                          ItemsSource="{Binding SortOptions}"
                          SelectedItem="{Binding SelectedSort, Mode=TwoWay}"
                          Style="{StaticResource AppComboBox}"
                          Width="148"
                          Margin="0,0,10,0" />

                <!-- New Task Button -->
                <Button AutomationProperties.AutomationId="NewTaskDialogButton"
                        Command="{Binding NewTaskDialogCommand}"
                        Style="{StaticResource Button.Primary}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{StaticResource Icon.Add}" Style="{StaticResource IconGlyph}" FontSize="13" Margin="0,0,6,0" />
                        <TextBlock Text="新建任务" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 2. Quick Add Bar -->
        <StackPanel Grid.Row="1" Margin="0,0,0,14">
            <Border CornerRadius="12"
                    Background="{DynamicResource Surface.2}"
                    BorderBrush="{DynamicResource Stroke.Subtle}"
                    BorderThickness="1"
                    Height="48"
                    Padding="14,0,8,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{StaticResource Icon.Add}"
                               Style="{StaticResource IconGlyph}"
                               FontSize="15"
                               Foreground="{DynamicResource Accent}"
                               Margin="0,0,10,0" />
                    <TextBox x:Name="QuickAddInput"
                             Grid.Column="1"
                             AutomationProperties.AutomationId="QuickAddTaskInput"
                             Text="{Binding QuickAddText, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{DynamicResource Text.Primary}"
                             CaretBrush="{DynamicResource Accent}"
                             FontSize="14"
                             VerticalContentAlignment="Center"
                             KeyDown="OnQuickAddKeyDown"
                             GotKeyboardFocus="OnQuickAddFocusChanged"
                             LostKeyboardFocus="OnQuickAddFocusChanged"
                             Style="{StaticResource AppTextBox}"
                             Height="44"
                             Padding="0"
                             themes:ControlProps.Placeholder="添加任务，回车保存（#标签 !高 ~3 预估）" />
                    <Button Grid.Column="2"
                            AutomationProperties.AutomationId="QuickAddTaskSubmit"
                            Content="添加"
                            Command="{Binding QuickAddCommand}"
                            Style="{StaticResource Button.Primary}"
                            Height="34"
                            MinWidth="68"
                            themes:ControlProps.CornerRadius="8" />
                </Grid>
            </Border>
            <TextBlock x:Name="QuickAddSyntaxHint"
                       Text="提示：输入 #标签   !高 / !中 / !低 优先级   ~数字 预估番茄数（如：写周报 #工作 !高 ~3）"
                       Style="{StaticResource Text.Caption}"
                       Margin="8,6,0,0"
                       Visibility="Collapsed" />
        </StackPanel>

        <!-- 3. Filter & Tag Chips Row -->
        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <controls:SegmentedControl Grid.Column="0"
                                       Width="292"
                                       SegmentHeight="30"
                                       Items="{Binding FilterOptions}"
                                       SelectedKey="{Binding SelectedFilterKey, Mode=TwoWay}" />

            <ScrollViewer Grid.Column="1"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          Margin="14,0,0,0"
                          VerticalAlignment="Center">
                <ItemsControl ItemsSource="{Binding TagChips}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.ToggleTagChipCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Cursor="Hand"
                                    Margin="0,0,6,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="ChipBd"
                                                Height="28"
                                                CornerRadius="8"
                                                Padding="10,0"
                                                BorderThickness="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource Surface.1}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Stroke.Subtle}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource Accent.Soft}" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding DisplayLabel}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- 4. Task List / Empty State -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsEmpty, Converter={StaticResource InvBoolToVis}}">
            <ItemsControl ItemsSource="{Binding Tasks}" Padding="0,0,4,12">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="RowCard"
                                CornerRadius="12"
                                Background="{DynamicResource Surface.1}"
                                BorderBrush="{DynamicResource Stroke.Subtle}"
                                BorderThickness="1"
                                Padding="12,11"
                                Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Priority Color Bar (4x28) -->
                                <Border Grid.Column="0" Width="4" Height="28" CornerRadius="2" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Priority}" Value="3">
                                                    <Setter Property="Background" Value="{DynamicResource Priority.High}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Priority}" Value="2">
                                                    <Setter Property="Background" Value="{DynamicResource Priority.Medium}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Priority}" Value="1">
                                                    <Setter Property="Background" Value="{DynamicResource Priority.Low}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>

                                <!-- Circular Complete Checkbox -->
                                <Button Grid.Column="1"
                                        Command="{Binding DataContext.ToggleTaskCompleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding Id}"
                                        Width="22"
                                        Height="22"
                                        Margin="0,0,12,0"
                                        Cursor="Hand"
                                        ToolTip="标记完成 / 取消完成">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border CornerRadius="999" BorderThickness="1.5">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Stroke.Strong}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource Success}" />
                                                                <Setter Property="BorderBrush" Value="{DynamicResource Success}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{StaticResource Icon.Check}"
                                                           Style="{StaticResource IconGlyph}"
                                                           FontSize="11"
                                                           Foreground="#FFFFFFFF"
                                                           Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVis}}" />
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- Title, Active Badge, Tags, Notes -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Title}"
                                                   ToolTip="{Binding Title}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource Text.Tertiary}" />
                                                            <Setter Property="TextDecorations" Value="Strikethrough" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <Border Height="20"
                                                    CornerRadius="6"
                                                    Padding="7,0"
                                                    Margin="0,0,6,0"
                                                    Background="{DynamicResource Phase.SoftBrush}"
                                                    Visibility="{Binding IsActiveFocusTask, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="专注中" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Phase.StartBrush}" VerticalAlignment="Center" />
                                            </Border>
                                            <ItemsControl ItemsSource="{Binding Tags}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource TagChipBorder}" Margin="0,0,4,0">
                                                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" VerticalAlignment="Center">
                                                                <Run Text="#" /><Run Text="{Binding Mode=OneWay}" />
                                                            </TextBlock>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="{Binding Notes}"
                                               ToolTip="{Binding Notes}"
                                               Style="{StaticResource Text.Caption}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,3,0,0"
                                               Visibility="{Binding HasNotes, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>

                                <!-- Tomato Progress Dots / Count -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0" Visibility="{Binding HasProgress, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl ItemsSource="{Binding TomatoDots}" Visibility="{Binding ShowDotRow, Converter={StaticResource BoolToVis}}" Margin="0,0,6,0" VerticalAlignment="Center">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Ellipse Width="7" Height="7" Margin="2,0">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="Transparent" />
                                                            <Setter Property="Stroke" Value="{DynamicResource Ring.Tick}" />
                                                            <Setter Property="StrokeThickness" Value="1.2" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsFilled}" Value="True">
                                                                    <Setter Property="Fill" Value="{DynamicResource Phase.StartBrush}" />
                                                                    <Setter Property="StrokeThickness" Value="0" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding ProgressSummaryText}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Text.Secondary}"
                                               Typography.NumeralAlignment="Tabular"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <!-- Action Buttons -->
                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Command="{Binding DataContext.StartFocusTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Id}"
                                            Style="{StaticResource Button.CircleIcon}"
                                            Width="32"
                                            Height="32"
                                            ToolTip="绑定并开始专注"
                                            Visibility="{Binding IsCompleted, Converter={StaticResource InvBoolToVis}}"
                                            Margin="0,0,4,0">
                                        <TextBlock Text="{StaticResource Icon.Play}" Style="{StaticResource IconGlyph}" FontSize="12" Foreground="{DynamicResource Phase.StartBrush}" />
                                    </Button>
                                    <Button Command="{Binding DataContext.EditTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Id}"
                                            Style="{StaticResource Button.Ghost}"
                                            Width="30"
                                            Height="30"
                                            MinWidth="30"
                                            Padding="0"
                                            ToolTip="编辑任务"
                                            Opacity="0.65">
                                        <TextBlock Text="{StaticResource Icon.Edit}" Style="{StaticResource IconGlyph}" FontSize="13" />
                                    </Button>
                                    <Button Command="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Id}"
                                            Style="{StaticResource Button.Ghost}"
                                            Width="30"
                                            Height="30"
                                            MinWidth="30"
                                            Padding="0"
                                            ToolTip="删除任务"
                                            Opacity="0.65">
                                        <TextBlock Text="{StaticResource Icon.Delete}" Style="{StaticResource IconGlyph}" FontSize="13" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Empty State -->
        <StackPanel Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{StaticResource Icon.NavTasks}" Style="{StaticResource IconGlyph}" FontSize="36" Foreground="{DynamicResource Text.Tertiary}" Margin="0,0,0,10" />
            <TextBlock Text="{Binding EmptyTitle}" Style="{StaticResource Text.CardTitle}" HorizontalAlignment="Center" Margin="0,0,0,4" />
            <TextBlock Text="{Binding EmptySubtitle}" Style="{StaticResource TextStyle.Secondary}" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
