<Window x:Class="PomodoroFocus.App.Views.MiniTimerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="番茄专注 · 迷你窗"
        Width="288"
        Height="92"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False">

    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="返回主窗口" Click="OnRestoreMainClick" />
            <MenuItem Header="不透明度">
                <MenuItem Header="100%" Tag="100" Click="OnOpacityMenuClick" />
                <MenuItem Header="90%" Tag="90" Click="OnOpacityMenuClick" />
                <MenuItem Header="80%" Tag="80" Click="OnOpacityMenuClick" />
                <MenuItem Header="70%" Tag="70" Click="OnOpacityMenuClick" />
            </MenuItem>
            <Separator />
            <MenuItem Header="关闭迷你窗" Click="OnCloseMiniClick" />
        </ContextMenu>
    </Window.ContextMenu>

    <Border x:Name="RootCard"
            CornerRadius="20"
            Background="{DynamicResource Surface.Solid}"
            BorderBrush="{DynamicResource Stroke.Strong}"
            BorderThickness="1"
            MouseLeftButtonDown="OnSurfaceMouseDown"
            SnapsToDevicePixels="True">
        <Border.Clip>
            <RectangleGeometry Rect="0,0,288,92" RadiusX="20" RadiusY="20" />
        </Border.Clip>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="26" />
                <RowDefinition Height="*" />
                <RowDefinition Height="10" />
            </Grid.RowDefinitions>

            <!-- Top Row: Phase Dot + Phase & Task Title + Restore Button -->
            <Grid Grid.Row="0" Margin="14,6,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse Grid.Column="0" Width="7" Height="7" Fill="{DynamicResource Phase.StartBrush}" VerticalAlignment="Center" Margin="0,0,7,0" />
                <TextBlock Grid.Column="1"
                           x:Name="MiniHeaderText"
                           FontSize="12"
                           FontWeight="Normal"
                           Foreground="{DynamicResource Text.Secondary}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
                <Button Grid.Column="2"
                        AutomationProperties.AutomationId="MiniRestoreButton"
                        Click="OnRestoreMainClick"
                        Style="{StaticResource Button.Ghost}"
                        Width="24"
                        Height="24"
                        MinWidth="24"
                        Padding="0"
                        ToolTip="返回主窗口 (双击窗口)">
                    <TextBlock Text="{StaticResource Icon.MiniExit}" Style="{StaticResource IconGlyph}" FontSize="12" />
                </Button>
            </Grid>

            <!-- Middle Row: 30pt Tabular Timer + 3 Compact Action Buttons -->
            <Grid Grid.Row="1" Margin="14,0,12,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           x:Name="MiniTimerText"
                           AutomationProperties.AutomationId="MiniTimerText"
                           AutomationProperties.Name="{Binding FocusVM.TimerText}"
                           Style="{StaticResource Text.TimerMini}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center">
                    <Run Text="{Binding FocusVM.TimerLeadText, Mode=OneWay}" /><InlineUIContainer BaselineAlignment="Baseline"><TextBlock Text=":" FontFamily="{StaticResource Font.Display}" FontSize="32" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}" Margin="0.5,0"><TextBlock.RenderTransform><TranslateTransform Y="-2.2" /></TextBlock.RenderTransform></TextBlock></InlineUIContainer><Run Text="{Binding FocusVM.TimerTrailText, Mode=OneWay}" />
                </TextBlock>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding FocusVM.ResetCommand}"
                            Style="{StaticResource Button.CircleIcon}"
                            Width="28"
                            Height="28"
                            ToolTip="重置"
                            Margin="0,0,6,0">
                        <TextBlock Text="{StaticResource Icon.Reset}" Style="{StaticResource IconGlyph}" FontSize="11" />
                    </Button>
                    <Button Command="{Binding FocusVM.ToggleCommand}"
                            Style="{StaticResource Button.TimerPrimary}"
                            Width="36"
                            Height="36"
                            ToolTip="{Binding FocusVM.PrimaryButtonTooltip}"
                            Margin="0,0,6,0">
                        <TextBlock Text="{Binding FocusVM.PrimaryButtonIcon}" Style="{StaticResource IconGlyph}" FontSize="14" Foreground="#FFFFFFFF" />
                    </Button>
                    <Button Command="{Binding FocusVM.SkipCommand}"
                            Style="{StaticResource Button.CircleIcon}"
                            Width="28"
                            Height="28"
                            ToolTip="{Binding FocusVM.SkipButtonTooltip}">
                        <TextBlock Text="{Binding FocusVM.SkipButtonIcon}" Style="{StaticResource IconGlyph}" FontSize="11" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Floating Inset Rounded Progress Pill (Dynamic Island / Home Indicator aesthetic) -->
            <Border Grid.Row="2"
                    Height="3.5"
                    CornerRadius="1.75"
                    Margin="16,0,16,6"
                    VerticalAlignment="Bottom"
                    Background="{DynamicResource Ring.Track}">
                <ProgressBar Value="{Binding FocusVM.Progress, Mode=OneWay}" Maximum="1.0" Height="3.5" Background="Transparent" BorderThickness="0">
                    <ProgressBar.Template>
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid x:Name="PART_Track">
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="1.75" Background="{DynamicResource Phase.Gradient}" />
                            </Grid>
                        </ControlTemplate>
                    </ProgressBar.Template>
                </ProgressBar>
            </Border>
        </Grid>
    </Border>
</Window>
